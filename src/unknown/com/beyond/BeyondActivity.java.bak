	public static int getAnKeyCode(int key) {
		int ret = 0;

		switch(key) {
			case DisplayBridge.MH_KEY_SELECT :
				ret = KeyEvent.KEYCODE_ENTER;
				break;
			case DisplayBridge.MH_KEY_UP:
				ret = KeyEvent.KEYCODE_DPAD_UP;
				break;
			case DisplayBridge.MH_KEY_RIGHT :
				ret = KeyEvent.KEYCODE_DPAD_RIGHT;
				break;
			case DisplayBridge.MH_KEY_LEFT:
				ret = KeyEvent.KEYCODE_DPAD_LEFT;
				break;
			case DisplayBridge.MH_KEY_DOWN :
				ret = KeyEvent.KEYCODE_DPAD_DOWN;
				break;
			case DisplayBridge.MH_KEY_SEND :
				ret = KeyEvent.KEYCODE_CALL;
				break;
			case DisplayBridge.MH_KEY_CLEAR :
				ret = KeyEvent.KEYCODE_DEL;
				break;
			case DisplayBridge.MH_KEY_POUND :
				ret = KeyEvent.KEYCODE_POUND;
				break;
			case DisplayBridge.MH_KEY_ASTERISK  :
				ret = KeyEvent.KEYCODE_STAR;
				break;
			case DisplayBridge.MH_KEY_SOFT1  :
				ret = KeyEvent.KEYCODE_SOFT_LEFT;
				break;
			case DisplayBridge.MH_KEY_SOFT3   :
				ret = KeyEvent.KEYCODE_SOFT_RIGHT;
				break;
			case DisplayBridge.MH_KEY_SIDE_DOWN   :
				//ret = KeyEvent.KEYCODE_VOLUME_DOWN;
				break;
			case DisplayBridge.MH_KEY_SIDE_UP    :
				//ret = KeyEvent.KEYCODE_VOLUME_UP;
				break;
			case DisplayBridge.MH_KEY_CAMERA     :
				ret = KeyEvent.KEYCODE_CAMERA;
				break;
			case DisplayBridge.MH_KEY_0  :
			case DisplayBridge.MH_KEY_1  :
			case DisplayBridge.MH_KEY_2  :
			case DisplayBridge.MH_KEY_3  :
			case DisplayBridge.MH_KEY_4  :
			case DisplayBridge.MH_KEY_5  :
			case DisplayBridge.MH_KEY_6  :
			case DisplayBridge.MH_KEY_7  :
			case DisplayBridge.MH_KEY_8  :
			case DisplayBridge.MH_KEY_9  :
				ret = key - DisplayBridge.MH_KEY_0 + KeyEvent.KEYCODE_0;            
				break;
		}        

		if((key >= DisplayBridge.MH_KEY_QUERTY_A) && (key <= DisplayBridge.MH_KEY_QUERTY_Z))
			return key - DisplayBridge.MH_KEY_QUERTY_A+KeyEvent.KEYCODE_A;

		return ret;        

	}

	public int getWipiKeyCode(int key) {
		int ret = 0;

		switch(key) {
			case KeyEvent.KEYCODE_DPAD_CENTER :
			case KeyEvent.KEYCODE_ENTER :
				ret = DisplayBridge.MH_KEY_SELECT;
				break;
			case KeyEvent.KEYCODE_DPAD_UP:
				ret = DisplayBridge.MH_KEY_UP;
				break;
			case KeyEvent.KEYCODE_DPAD_RIGHT :
				ret = DisplayBridge.MH_KEY_RIGHT;
				break;
			case KeyEvent.KEYCODE_DPAD_LEFT:
				ret = DisplayBridge.MH_KEY_LEFT;
				break;
			case KeyEvent.KEYCODE_DPAD_DOWN :
				ret = DisplayBridge.MH_KEY_DOWN;
				break;
			case KeyEvent.KEYCODE_CALL :
				ret = DisplayBridge.MH_KEY_SEND;
				break;            
		    case KeyEvent.KEYCODE_MENU :	// 82
				ret = key;							// for qwertymaster
		    	break;
			case KeyEvent.KEYCODE_BACK :	// 4
				ret = key;							// for qwertymaster
				break;                
			case KeyEvent.KEYCODE_DEL :
			case KeyEvent.KEYCODE_CLEAR  :
				ret = DisplayBridge.MH_KEY_CLEAR;
				break;
			case KeyEvent.KEYCODE_POUND :
				ret = DisplayBridge.MH_KEY_POUND;
				break;
			case KeyEvent.KEYCODE_STAR  :
				ret = DisplayBridge.MH_KEY_ASTERISK;
				break;
			case KeyEvent.KEYCODE_SOFT_LEFT  :
				ret = DisplayBridge.MH_KEY_SOFT1;
				break;
			case KeyEvent.KEYCODE_SOFT_RIGHT   :
				ret = DisplayBridge.MH_KEY_SOFT3;
				break;
			case KeyEvent.KEYCODE_VOLUME_DOWN   :
				if (isAppHandleSIDEKey) 
					ret = DisplayBridge.MH_KEY_SIDE_DOWN;
				break;
			case KeyEvent.KEYCODE_VOLUME_UP    :
				if (isAppHandleSIDEKey) 
					ret = DisplayBridge.MH_KEY_SIDE_UP;
				break;
			case KeyEvent.KEYCODE_CAMERA     :
				ret = DisplayBridge.MH_KEY_CAMERA;
				break;
			case KeyEvent.KEYCODE_0  :
			case KeyEvent.KEYCODE_1  :
			case KeyEvent.KEYCODE_2  :
			case KeyEvent.KEYCODE_3  :
			case KeyEvent.KEYCODE_4  :
			case KeyEvent.KEYCODE_5  :
			case KeyEvent.KEYCODE_6  :
			case KeyEvent.KEYCODE_8  :
			case KeyEvent.KEYCODE_9  :
				ret = DisplayBridge.MH_KEY_0 + key - KeyEvent.KEYCODE_0;            
				break;
		}        
		if((key >= KeyEvent.KEYCODE_A) && (key <= KeyEvent.KEYCODE_Z))
			return DisplayBridge.MH_KEY_QUERTY_A + key-KeyEvent.KEYCODE_A;

		return ret;        
	}

	protected int getWipiKeyEvent(int action) {
		int ret = -1;

		switch(action) {
			case KeyEvent.ACTION_DOWN :
				ret = EventQueueBridge.KEY_PRESSED;
				break;
			case KeyEvent.ACTION_UP  :
				ret = EventQueueBridge.KEY_RELEASED;
				break;
			case KeyEvent.ACTION_MULTIPLE :
				ret = EventQueueBridge.KEY_REPEATED;
				break;
		}

		return ret;    
	}    

