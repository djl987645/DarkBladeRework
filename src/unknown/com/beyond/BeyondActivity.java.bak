    private WebView mViewWeb = null;
    
    public static void onHideSUI() {
    	BeyondActivity acti = (BeyondActivity) context;
    	if(acti.mViewWeb != null) {
    		Message msg = new Message();
    		MessageInfo msgInfo = new MessageInfo();
    		
    		msgInfo.command = MessageInfo.MIC_WEBVIEW;
    		msgInfo.subCommand = MessageInfo.MISC_REMOVE;
    		
    		msg.what = BeyondActivity.MESSAGE;
    		msg.obj = msgInfo;
    		
    		BeyondActivity.getHandler2().sendMessage(msg);    		
    	}
    }
    
    private void onMsgWebView(MessageInfo msg) {
    	switch(msg.subCommand) {
    	case MessageInfo.MISC_CREATE:
    		mViewWeb = new WebView(this.context);
    		mViewWeb.loadUrl(msg.stringValue);
    		mViewWeb.setVisibility(View.INVISIBLE);
    		//mViewWeb.setVisibility(View.VISIBLE);
    		vg.addView(mViewWeb, new AbsoluteLayout.LayoutParams(msg.rc.width(), msg.rc.height(), msg.rc.left, msg.rc.top));
    		//!@wjl vg.addView(mViewWeb,1,1);
    		break;
    	case MessageInfo.MISC_REMOVE:
    		if(mViewWeb != null) {
    			vg.removeView(mViewWeb);
    			mViewWeb = null;
    		}
    		break;
    	case MessageInfo.MISC_SHOW:
    		mViewWeb.setVisibility(View.VISIBLE);
    		//onMsgWebView(msg);
    		break;
    	case MessageInfo.MISC_HIDE:
    		mViewWeb.setVisibility(View.INVISIBLE);
    		//onMsgWebView(msg);
    		break;
    	}    	
    }
    
	protected void onRetryKafInit(Object arg) {
	}    
    
    void onMessage(MessageInfo msg) {
    	switch(msg.command) {
    	case MessageInfo.MIC_WEBVIEW:
    		onMsgWebView(msg);
    		break;
    	}
    }
     
		

	private void CreateHandler() {
		handler = new Handler(){
			public void handleMessage(Message msg) {
				//System.out.println("message.what = "+msg.what);
				switch (msg.what)
				{
				case MESSAGE:
					onMessage((MessageInfo)msg.obj);
					break;
				case EDIT_SETTEXT:
					if (jf != null)
						jf.setText((String)msg.obj);
					break;
				case EDIT_SETPOSITION:
					if (jf != null)
						jf.setSelection(msg.arg1);
					break;
				case EDIT_SHOWSWIP:
					if (jf != null){
						InputMethodManager imm = (InputMethodManager)getSystemService(INPUT_METHOD_SERVICE);
						imm.showSoftInput(jf, 0);
					}
					break;
				case EXIT_ACTIVITY:
					System.exit(0);
					break;				
				case ADD_AD:
					onRequestAdView(true, (Rect)msg.obj);
					break;						
				case REMOVE_AD:
					onRequestAdView(false, null);
					break;						
				case SHOW_AD:
					onShowAdView(true);
					break;						
				case HIDE_AD:
					onShowAdView(false);
					//onRequestAdView(false, null);
					break;						
				case SHOWANNUN:
					onShowAnnun();
					//ScreenConfig.getAnnunInfo().height = Integer.parseInt(s);
					break;
				case SHOW_DIALOG:					
					onShowDialog(msg.obj);
					//ScreenConfig.getAnnunInfo().height = Integer.parseInt(s);
					break;
				case RETRY_KAFINIT:					
					onRetryKafInit(msg.obj);
					break;
				case APP_START:
					appStart();
					break;
/////////////////////////////////////////////////////////////////////////////////////////////////////////////
//!@wjl INAPP
				case BUY_ITEM:
					{

						// INSA - 2011.09.07
						//==================
						//#########################################################
						// SKT
						//#########################################################
						//String _as[] = (String[])msg.obj;
						//popPurchaseDlg(_as[0],_as[1]);
						
						//#########################################################
						// KT
						//#########################################################
						String _as = (String)msg.obj;
						purchase(_as);
						//==================

					}
					break;
				case TEST_MSG:
//					Log.i("TEST","Handler msg : " + msg.obj);
					break;
				//case SOCKET_CONNECT:
				//	{
				//		netSocketConnect(msg.obj);
				//	}
				case SHOW_TOAST:
					ShowToast((String)msg.obj);
					break;
				}
			}
		};
	}

