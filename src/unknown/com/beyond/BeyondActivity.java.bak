	boolean enableSensor(boolean isSet, boolean Clet) {
    	if(isSet) {
    		if(mSensor != null)
    			return true;
    		
    		mSensor = new Sensor(Clet);
            mSensorManager.registerListener(mSensor, 
                    SensorManager.SENSOR_ACCELEROMETER,
                    SensorManager.SENSOR_DELAY_GAME);      		
    	}
    	else {
    		if(mSensor == null)
    			return true;

    		mSensorManager.unregisterListener(mSensor);
    		mSensor = null;
    	}
    	
    	return false;
    }	
    
