		// TODO Auto-generated method stub
		
	}
	

	public static void toShowToast(String str) {
		Message msg = new Message();
	    msg.what = BeyondActivity.SHOW_TOAST;
	    msg.obj = str;//addr
	    BeyondActivity.getHandler2().sendMessage(msg);
	}
	
	public static void ShowToast(String str)
	{
		Toast toast = Toast.makeText(BeyondActivity.context, str, Toast.LENGTH_LONG);
	    toast.show();
	}
