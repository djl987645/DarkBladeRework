	public void onCreate(Bundle savedInstanceState) {
//			instance = this;
		context = this;
		CreateHandler();

		super.onCreate(savedInstanceState);

		carrier = BeyondBridge.getSystemProperty0("carrier");
		if (carrier.equals("BEYOND")) {
			String license = BeyondBridge.getSystemProperty0("license");
			if(license.equals("YES"))
				CONFIG_BUILD_SDK = true;
		}

		setTheme(android.R.style.Theme_Black_NoTitleBar_Fullscreen);

		getWindow().requestFeature(android.view.Window.FEATURE_NO_TITLE); 
		this.getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN ,
				WindowManager.LayoutParams.FLAG_FULLSCREEN );
		mSensorManager = (SensorManager) getSystemService(SENSOR_SERVICE);			

		vg = new AbsoluteLayout(this);
		setContentView(vg);

  		// set keypad configuration
		Configuration config = getResources().getConfiguration();
		BeyondBridge.setSystemProperty0("KEYPAD", Integer.toString(config.keyboard));
		BeyondBridge.setSystemProperty0("HD_KEYPAD_HIDDEN", Integer.toString(config.hardKeyboardHidden));

		//CreateHandler();		
	}
	
	public static void requestAdView(boolean isShow, Rect rc) {
    	Message msg = new Message();
    	if(isShow) {
    		msg.what = ADD_AD;
    		msg.obj = (Object)rc;
    	}
    	else {
    		msg.what = REMOVE_AD;
    	}
    	handler.sendMessage(msg);		
	}
	
	public void onRequestAdView(boolean isShow, Rect rc) {
		System.out.println("showAdView("+isShow+","+rc+")");
		if(AdMgr.isSupport() == false)
			return;
		
		if(isShow)
			AdMgr.getInstance().start(context, vg, rc);
		else
			AdMgr.getInstance().stop(vg);
	}
	
	
	public static void showAdView(boolean isShow) {
    	Message msg = new Message();
    	if(isShow) {
    		msg.what = SHOW_AD;    		
    	}
    	else {
    		msg.what = HIDE_AD;
    	}
    	handler.sendMessage(msg);
	}		
		
	public void onShowAdView(boolean isShow) {
		if(AdMgr.isSupport() == false)
			return;
		AdMgr.getInstance().setVisible(isShow);
	}		
	
	public static void showDialog(DialogInfo dlgInfo) {
		Message msg = new Message();
		msg.what = SHOW_DIALOG;
		msg.obj = dlgInfo;
		handler.sendMessage(msg);
	}
	
	protected void onShowDialog(Object arg) {
		DialogInfo dlgInfo = (DialogInfo)arg;
		this.scrConfig.showDlg(dlgInfo.title, dlgInfo.content, dlgInfo.type, dlgInfo.listener);
	}
	
		
	public void onWindowFocusChanged(boolean hasFocus) {
		System.out.println("onWindowFocusChanged("+hasFocus+")");
		if(hasFocus)
			onAppResume();
		else
			onAppPause();
	}
	
