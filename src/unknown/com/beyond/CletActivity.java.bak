	private static android.media.AudioManager getAudioManager() {
		android.media.AudioManager am = (android.media.AudioManager) CletActivity.context.getSystemService(android.content.Context.AUDIO_SERVICE);
		return am;
	}	
	public void setVolumeMedia(int volume){
		android.media.AudioManager am = getAudioManager();
		int streamType = android.media.AudioManager.STREAM_MUSIC;
//		am.setStreamVolume(streamType, (volume*am.getStreamMaxVolume(streamType))/100, 0);		
		
		if(volume > 0 && MediaBridge.volum_onoff_mode)
			am.setStreamVolume(streamType, am.getStreamVolume(streamType), 0);
		else{
			am.setStreamVolume(streamType, (volume*am.getStreamMaxVolume(streamType))/100, 0);
		}
		return;	
	}
	
	public int getVolumeMedia() {
		android.media.AudioManager am = getAudioManager();
		int streamType = android.media.AudioManager.STREAM_MUSIC;
		return (am.getStreamVolume(streamType)*100)/am.getStreamMaxVolume(streamType);						
	}
	
	public int getMuteState(String cateID) {
		android.media.AudioManager am = getAudioManager();
		if (cateID.compareTo("RING") == 0){
			int muteState = am.getRingerMode();
			if (muteState == android.media.AudioManager.RINGER_MODE_NORMAL){
				if( am.getStreamVolume(android.media.AudioManager.STREAM_RING) == 0)
					return 1;
				return 0;
			}
			return 1;
		}
		return 0;						
	}

	public void vibrator(int level, int duration) {
		try{
			android.os.Vibrator vib = (android.os.Vibrator) CletActivity.context.getSystemService(
        		android.content.Context.VIBRATOR_SERVICE);
			if((level==0)&&(duration==0))
				vib.cancel();
			else
				vib.vibrate(duration);
		}catch(SecurityException e)
		{
			return;
		}
	}
	
