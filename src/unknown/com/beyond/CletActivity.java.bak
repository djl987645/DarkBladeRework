class CMediaPlayer
{
	private final static int  MC_MDA_STATUS_ERROR = -1;
	private final static int  MC_MDA_STATUS_END_OF_DATA = 1;
	private final static int  MC_MDA_STATUS_START = 2;
	private final static int  MC_MDA_STATUS_STOP = 3;
	private final static int  MC_MDA_STATUS_PAUSE = 4;
	private final static int  MC_MDA_STATUS_RESUME = 5;
	private final static int  MC_MDA_STATUS_RECORD = 6;
	private final static int  MC_MDA_STATUS_FULL_OF_DATA = 7;
	private final static int  MC_MDA_STATUS_FILENOSPACE	= 8;
	private final static int  MC_MDA_STATUS_OEM_ERROR =	9;
	private final static int  MC_MDA_STATUS_END_OF_MEDIA = 10;
	private final static int  MC_MDA_STATUS_STOPPED_AT_TIME	= 11;
	
	private File mediaFile;
	private AppThread appTh;
	private int mediaID;
	private File cachedir;
    private int soundid;
    private boolean mrepeate = false;
    private android.media.MediaPlayer mp = null;
    
	public CMediaPlayer(File dir, int id, AppThread appTh){
		cachedir = dir;
		this.appTh = appTh;		
		mediaID = id;
		soundid = -1;
		return;
	}
	
	public void wirtedata(byte[] data, boolean repeate){

		try{
			mp = new android.media.MediaPlayer();
			mediaFile = new File(cachedir.getAbsolutePath()+"/Media_"+mediaID);
			mediaFile.deleteOnExit();			
			java.io.FileOutputStream outStream = new java.io.FileOutputStream(mediaFile, false);
			outStream.write(data, 0, data.length);
			outStream.close();
			java.io.FileInputStream inbuf = new java.io.FileInputStream(mediaFile);
			mp.setDataSource(inbuf.getFD());
			inbuf.close();
	        if(repeate)
	        	mp.setLooping(true);	
	        mp.prepare();
		} catch (IOException e) { 
			return; 
		}
		return;
	}
	
	
	public void setres(String resName, boolean repeate){
	
		if(resName.charAt(0) == '/')
			resName = resName.substring(1);	
		
		if(!appTh.getSoundMapKey(resName)){
			try{
				
				if (resName.startsWith("sdcard/") == true) {
					File myfile = new File(resName);
					java.io.FileInputStream inbuf = new java.io.FileInputStream(myfile);
					FileDescriptor fd = inbuf.getFD();
					
					mp = new android.media.MediaPlayer();
					mp.setDataSource(fd);
					mp.prepare();
			        if(repeate)
			        	mp.setLooping(true);	
				}
				else {		      
					android.content.res.AssetFileDescriptor afd = CletActivity.context.getAssets().openFd(resName);
					mp = new android.media.MediaPlayer();
					mp.setDataSource(afd.getFileDescriptor(), afd.getStartOffset(), afd.getLength());
					mp.prepare();
			        if(repeate)
			        	mp.setLooping(true);	
					afd.close();
				}
		        
			} catch (IOException e) { 
				return; 
			}
		}else{
			soundid = appTh.getSoundMapID(resName);
		}
		return;
	}
		
	public void play(){
		if(soundid == -1){
			if(mp == null)
				return;
			mp.setOnCompletionListener(new android.media.MediaPlayer.OnCompletionListener() {                 
				public void onCompletion(android.media.MediaPlayer arg0) { 
					if(appTh != null){
						appTh.BhandleMediaEvent(arg0, MC_MDA_STATUS_END_OF_DATA);
					}
				}
			});
			mp.start();	
		}else{
			appTh.playSoundMap(soundid, mrepeate);
		}
	}
	public void stop(){
		if(soundid == -1){
			if(mp == null)
				return;
			mp.stop();
			mp.setOnCompletionListener(null);
		}else{
			appTh.stopSoundMap(soundid);
		}
	}
	
	public void close(){
			if(mp != null)
				mp.release();
			mediaFile = null;
	}	
}//end of CMediaPlayer

