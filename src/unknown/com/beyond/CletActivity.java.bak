	private void subCreate(){
		/*
        setTheme(android.R.style.Theme_Black_NoTitleBar_Fullscreen);

        getWindow().requestFeature(android.view.Window.FEATURE_NO_TITLE); 
        this.getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN ,
        		WindowManager.LayoutParams.FLAG_FULLSCREEN );        
        mSensorManager = (SensorManager) getSystemService(SENSOR_SERVICE);                

        // BeyondActivyty.vg
        ViewGroup vg = new AbsoluteLayout(this);
        setContentView(vg);
*/        
	
       // ScreenConfig scrConfig = new ScreenConfig();
		scrConfig = new ScreenConfig();
        scrConfig.initConfig(this, new Point(vg.getWidth(), vg.getHeight()), true);        
        this.setRequestedOrientation(scrConfig.getScreenMode());

        view = new AppFrameBuffer(this);
        Rect playerRect = scrConfig.getPlayerRect();
        
        //여기서 화면 비율 조정?
        int display_size = 100; 
        
        if(Build.VERSION.SDK_INT > 10){
        	display_size = 95;
        }

        
        if(playerRect == null) {
//        	setContentView(view);
        	android.view.Display display = ((WindowManager) getSystemService(Context.WINDOW_SERVICE)).getDefaultDisplay(); 
        	vg.addView(view, new AbsoluteLayout.LayoutParams(display.getWidth(), display.getHeight(), 0, 0));
        	appTh.setCanvasSize(display.getWidth(), display.getHeight(), 0, 0, display.getWidth(), display.getHeight());
//        	Log.i("LCD_SIZE","width"+display.getWidth()+":height"+display.getHeight());
        }
        else {
            Rect gameDisplayRect = scrConfig.getGameDisplayRect();
            if(gameDisplayRect == null) {
            	gameDisplaySize = new Point(playerRect.width(), playerRect.height());
            }
            else {
            	
            	gameDisplaySize = new Point(gameDisplayRect.width(), gameDisplayRect.height());
            	view.setScaleRatio((float)gameDisplayRect.width()/(float)playerRect.width(), (float)gameDisplayRect.height()/(float)(playerRect.height()*display_size/100));
            }
        	
	        vg.addView(view, new AbsoluteLayout.LayoutParams(playerRect.width(), playerRect.height()*display_size/100, playerRect.left, playerRect.top));
	        scrConfig.makeScreen(vg, view, -1);
			appTh.setCanvasSize(gameDisplaySize.x, gameDisplaySize.y, playerRect.left, playerRect.top, playerRect.width(), playerRect.height()*display_size/100);
        }

        /*
		 * docomo authentication
		 */
        if (isDocomoAuth == false){
			appTh.setContext(this);
			appTh.start();
		}

	}
	/** Called when the activity is first created. */
	public void onCreate(Bundle savedInstanceState) {
		instance = this;
        super.onCreate(savedInstanceState);
        context = this;
        appTh = new AppThread(this); 
        subCreate();
	}

	public void onCreate(Bundle savedInstanceState, String[] resNames) {
		instance = this;
        super.onCreate(savedInstanceState);
        context = this;
        appTh = new AppThread(this, resNames); 
        s_pool_type = resNames[0].substring(resNames[0].length()-4);
        subCreate();	
	}

	public void onCreate(Bundle savedInstanceState, String[] resNames, String appID) {
		instance = this;
		super.onCreate(savedInstanceState);
        context = this;
        soundPoolRes = resNames;
        s_pool_type = resNames[0].substring(resNames[0].length()-4);
        //!@kmg
