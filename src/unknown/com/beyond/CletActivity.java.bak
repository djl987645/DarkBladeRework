	//!@wjl web 출력
	
	public void showWeb(String url)
	{
		if(url!=null)
		{
			Rect rc = new Rect();
			rc.set(0,0,1,1);
			Message msg = new Message();
			MessageInfo msgInfo = new MessageInfo();
			
			msgInfo.command = MessageInfo.MIC_WEBVIEW;
			msgInfo.subCommand = MessageInfo.MISC_CREATE;
			msgInfo.rc = new Rect(rc);
			msgInfo.stringValue = url;
			
			msg.what = BeyondActivity.MESSAGE;
			msg.obj = msgInfo;
			
			BeyondActivity.getHandler2().sendMessage(msg);
		}else{
			
		}
	}
	
	public int readCount = 0;
	public int writeCount = 0;
