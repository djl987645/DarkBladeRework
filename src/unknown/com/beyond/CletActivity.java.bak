	public boolean onKeyDown(int keyCode, KeyEvent event) {
		if (isAppHandleSIDEKey) {
			if (keyCode == KeyEvent.KEYCODE_VOLUME_DOWN)
			{
				System.out.println("getWipiKeyCode = KeyEvent.KEYCODE_VOLUME_DOWN");
				android.media.AudioManager am = (AudioManager) getSystemService(AUDIO_SERVICE);
				int streamType = android.media.AudioManager.STREAM_MUSIC;
				int volume = am.getStreamVolume(streamType)*100/am.getStreamMaxVolume(streamType);
				int max = am.getStreamMaxVolume(streamType);
				int vol = am.getStreamVolume(streamType);
				am.setStreamVolume(streamType, (volume-10)*am.getStreamMaxVolume(streamType)/100, AudioManager.FLAG_SHOW_UI);
				return true;
			}
			else if (keyCode == KeyEvent.KEYCODE_VOLUME_UP) {
				System.out.println("getWipiKeyCode = KeyEvent.KEYCODE_VOLUME_UP");
				android.media.AudioManager am = (AudioManager) getSystemService(AUDIO_SERVICE);
				int streamType = android.media.AudioManager.STREAM_MUSIC;
				int volume = am.getStreamVolume(streamType)*100/am.getStreamMaxVolume(streamType);
				am.setStreamVolume(streamType, (volume+10)*am.getStreamMaxVolume(streamType)/100, AudioManager.FLAG_SHOW_UI);
				return true;
			}
		}

		int wipikey = getWipiKeyCode(keyCode);
		if (wipikey !=0 && appTh.BhandleKeyEvent(MH_KEY_PRESSEVENT, wipikey))
			return true;
		else
			return super.onKeyDown(keyCode, event);
	}


	public boolean onKeyUp(int keyCode, KeyEvent event) {
		if (isAppHandleReturnKey == false) {			  		
			if (keyCode == KeyEvent.KEYCODE_BACK) {
				showExitDlg();
//				finish();
				return true;
			}
		}
		
		int wipikey = getWipiKeyCode(keyCode);
		if (wipikey !=0 && appTh.BhandleKeyEvent(MH_KEY_RELEASEEVENT, wipikey))
			return true;
		else
			return super.onKeyUp(keyCode, event);
	}


	public boolean onTouchEvent(MotionEvent event) {
		int type = event.getAction();
		//Log.i("TOUCH","onTouchEvent 0 "+event.getPointerCount()+",type="+type);
		int x = (int)event.getX();
		int y = (int)event.getY();
		if(view.x_ratio != 1)
			x = (int)(x*view.x_ratio);			
		if(view.y_ratio != 1)
			y = (int)(y*view.y_ratio);  
		
		if(type == MotionEvent.ACTION_DOWN){
			appTh.BhandleTouchPress(x , y,0);
			return true;
			
		}else if(type == MotionEvent.ACTION_UP){
			appTh.BhandleTouchRelease(x , y,0);
			return true;
			
		}else if(type == MotionEvent.ACTION_MOVE){
			appTh.BhandleTouchDrag(x , y,0);
			return true;
		} 		
		
		return super.onTouchEvent(event);
	}


	protected void onAppPause() {
		
		if(appTh != null)
			appTh.pltPause();
	}
	
	protected void onAppResume() {

		if(firstResume == true) {
			firstResume = false;
			return;
		}
		if(appTh != null)
			appTh.pltResume();
	}	
