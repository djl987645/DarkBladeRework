	private void loadSoundPool(String[] resNames){ 
		String resPath = AppProperty.getString("ext_res");
		if(resNames != null){
			for(int i = 0; i<resNames.length; i++){
				try{
					String resName = resNames[i];
					if (resPath == null){
						android.content.res.AssetFileDescriptor afd = CletActivity.context.getAssets().openFd(resName);
						int soundid = soundPool.load(afd.getFileDescriptor(), afd.getStartOffset(), afd.getLength(), 1);
						//Log.i("TEST","loadSoundPool:"+soundid+","+resName);
						afd.close();
						soundPoolMap.put(resName, soundid);
					}
					else {
						int soundid = soundPool.load(resPath+resNames[i], 1);						
						soundPoolMap.put(resPath+resName, soundid);
					}
				} catch (IOException e) {
					e.printStackTrace();
					//Log.i("ERROR","loadSoundPool");
					return; 
				}
			}
		}
	}		
	public void drawRightLogoI(int restDays){//!@wjl CHK
		int x = 35;
		int y = 40;
		int fontsize = 15;
		int h = fontsize + 5; // font size + 여백

		while(mHolder == null) {
			try {
				java.lang.Thread.sleep(100);
			}
			catch(Exception e) {
			}
		}

		Canvas canvas = mHolder.lockCanvas();

		TextPaint paint = new TextPaint();
		Typeface tf = Typeface.create(Typeface.DEFAULT , Typeface.NORMAL);
		paint.setTextSize(fontsize);
		paint.setTypeface(tf);
		paint.setSubpixelText(true);
		paint.setAntiAlias(true);
		paint.setColor(Color.WHITE);
		paint.setStrokeWidth(canvas.getWidth());
		paint.setStrokeCap(Paint.Cap.ROUND);

		if(restDays > 0) {
			canvas.drawText("License will be expired "+restDays+" days after.", x, y, paint);
			y += h;
			canvas.drawText("To continue testing,", x, y, paint);
			y += h;
			canvas.drawText("Touch the screen !!!", x, y, paint);
		}
		else {
			canvas.drawText("License  alredy expired !!!", x, y, paint);
			y += h;
			canvas.drawText("Get the new libraries.", x, y, paint);
		}

		y = 180;
		canvas.drawText("This application must be used for", x, y, paint);
		y += h;
		canvas.drawText("  non-commercial only.", x, y, paint);
		y += h;
		canvas.drawText("If you want to commercial use,", x, y, paint);
		y += h;
		canvas.drawText("  contact to biz@beyonde.co.kr", x, y, paint);
		y += h;
		canvas.drawText("       or        www.beyonde.co.kr", x, y, paint);

		mHolder.unlockCanvasAndPost(canvas);
	}
	
	public void drawBeyondLogo(){//!wjl CHK

                //if(AppProperty.getInt("skip_blog") != 1) {
                //환경세팅 오류 위가 원본소스 위에서 안걸려서 1을 0으로 수정
		if(AppProperty.getInt("skip_blog") != 0) {
			Bitmap logo =  SUIBase.loadImage("fl.bl");
			
			while(mHolder == null) {
				try {
					java.lang.Thread.sleep(1);
				}
				catch(Exception e) {
				}
			}
	
			Canvas canvas = mHolder.lockCanvas();
	
			Paint paint = new Paint();
			canvas.drawColor(Color.WHITE);
			float x = (canvas.getWidth()-logo.getWidth())/2;
			float y = (canvas.getHeight()-logo.getHeight())/2;
			canvas.drawBitmap(logo, x, y, paint);
	
			mHolder.unlockCanvasAndPost(canvas);
		}
	}

	private static DialogInfo m_dlgInfo;	
	public void knlshowExitDlg(char[] title, char[] error)
	{
		m_dlgInfo = new DialogInfo();
		m_dlgInfo.content = new String(error);
		m_dlgInfo.title = new String(title);
		m_dlgInfo.type = 11;

		m_dlgInfo.listener =  new DialogInterface.OnClickListener(){
			public void onClick(DialogInterface dialog, int which) {
				if(m_dlgInfo != null) {
					dialog.dismiss();
					m_dlgInfo = null;
				}
				if(which == DialogInterface.BUTTON_POSITIVE) {
					m_dlgInfo = null;
					host.finish();
					return;
				}
			}}; 				
		BeyondActivity.showDialog(m_dlgInfo);
	}

	public void finish() {
		host.finish();
	}
	
