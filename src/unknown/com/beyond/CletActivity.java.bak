		private void dumpEvent(MotionEvent event) {
			   String names[] = { "DOWN" , "UP" , "MOVE" , "CANCEL" , "OUTSIDE" ,
			      "POINTER_DOWN" , "POINTER_UP" , "7?" , "8?" , "9?" };
			   StringBuilder sb = new StringBuilder();
			   int action = event.getAction();
			   int actionCode = action & MotionEvent.ACTION_MASK;
			   sb.append("event ACTION_" ).append(names[actionCode]);
			   if (actionCode == MotionEvent.ACTION_POINTER_DOWN
			         || actionCode == MotionEvent.ACTION_POINTER_UP) {
			      sb.append("(pid " ).append(
			      action >> MotionEvent.ACTION_POINTER_ID_SHIFT);
			      sb.append(")" );
			   }
			   sb.append("[" );
			   for (int i = 0; i < event.getPointerCount(); i++) {
			      sb.append("#" ).append(i);
			      sb.append("(pid " ).append(event.getPointerId(i));
			      sb.append(")=" ).append((int) event.getX(i));
			      sb.append("," ).append((int) event.getY(i));
			      if (i + 1 < event.getPointerCount())
			         sb.append(";" );
			   }
			   sb.append("]" );
			   Log.d("TOUCH", sb.toString());
		}
		
		
		boolean IS_DBTOUCH = true;
		int 	pid = 1;
		int 	pcount = 0;
		public boolean onTouchDbEvent(MotionEvent event)
		{
			//dumpEvent(event);
			int pointerCount = event.getPointerCount();
			
			if(event.getPointerCount() > 2){
				super.onTouchEvent(event);
				return true;
			}
			int action = event.getAction();
			int actionCode =(action& MotionEvent.ACTION_MASK); 
			int x = 0;
			int y = 0;
			int i = 0;
			if((action >> MotionEvent.ACTION_POINTER_ID_SHIFT) > 0)
			{
				i = (action >> MotionEvent.ACTION_POINTER_ID_SHIFT);
			}
			
			if(actionCode != MotionEvent.ACTION_MOVE)
			{
				x = (int)event.getX(event.getPointerId(i));
				y = (int)event.getY(event.getPointerId(i));
				
				if(x_ratio != 1)
					x = (int)(x*x_ratio);			
				if(y_ratio != 1)
					y = (int)(y*y_ratio); 
				//Log.i("TOUCH","@"+i+",PID="+event.getPointerId(i)+"x="+x+",y="+y+",xratio="+x_ratio+",yratio="+y_ratio);
				
				switch(actionCode) {
				case MotionEvent.ACTION_DOWN://pid 0 
					appTh.BhandleTouchPress(x , y,i);
					break;
				case MotionEvent.ACTION_POINTER_DOWN://pid 1
					//Log.i("TOUCH","P["+i+","+tcId+"]x ="+x+",y ="+y);
					appTh.BhandleTouchPress(x , y,i);
					break;//return true;
				case MotionEvent.ACTION_UP://pid 0
					appTh.BhandleTouchRelease(x , y,i);
					break;
				case MotionEvent.ACTION_POINTER_UP:
					//Log.i("TOUCH","R["+i+","+tcId+"]x ="+x+",y ="+y);
					appTh.BhandleTouchRelease(x , y,i);
					break;//return true;
				case MotionEvent.ACTION_MOVE:
					//Log.i("TOUCH","M["+i+","+tcId+"]x ="+x+",y ="+y);
					appTh.BhandleTouchDrag(x , y,i);
					break;//return true;
				}
			}
			else
			{

				for(;i<pointerCount;i++)
				{
					x = (int)event.getX(event.getPointerId(i));
					y = (int)event.getY(event.getPointerId(i));
					
					if(x_ratio != 1)
						x = (int)(x*x_ratio); 
					if(y_ratio != 1)
						y = (int)(y*y_ratio); 
					//Log.i("TOUCH","@"+i+",PID="+event.getPointerId(i)+"x="+x+",y="+y+",xratio="+x_ratio+",yratio="+y_ratio);
					
					switch(actionCode) {
					case MotionEvent.ACTION_DOWN://pid 0 
						appTh.BhandleTouchPress(x , y,i);
						break;
					case MotionEvent.ACTION_POINTER_DOWN://pid 1
						//Log.i("TOUCH","P["+i+","+tcId+"]x ="+x+",y ="+y);
						appTh.BhandleTouchPress(x , y,i);
						break;//return true;
					case MotionEvent.ACTION_UP://pid 0
						appTh.BhandleTouchRelease(x , y,i);
						break;
					case MotionEvent.ACTION_POINTER_UP:
						//Log.i("TOUCH","R["+i+","+tcId+"]x ="+x+",y ="+y);
						appTh.BhandleTouchRelease(x , y,i);
						break;//return true;
					case MotionEvent.ACTION_MOVE:
						//Log.i("TOUCH","M["+i+","+tcId+"]x ="+x+",y ="+y);
						appTh.BhandleTouchDrag(x , y,i);
						break;//return true;
					}
				}
			}
			
			return true;//return super.onTouchEvent(event); 
		}
		//-->20110706
		
		
		public boolean onTouchEvent(MotionEvent event) {
			if(suiMgr.onTouchEvent(event, this))
				return true;
			if(IS_DBTOUCH == true)
			{
				return onTouchDbEvent(event);
			}
			else{
			
			int pointerCount = event.getPointerCount();
			
			if(event.getPointerCount() > 2){
				super.onTouchEvent(event);
				return true;
			}
			int action = event.getAction();
			int actionCode =(action& MotionEvent.ACTION_MASK); 
			int x = 0;
			int y = 0;
				
				//이벤트로 터치 인덱스 구하기
				int tcId = 0;
				tcId = (action >> MotionEvent.ACTION_POINTER_ID_SHIFT);
				x = (int)event.getX(tcId);
				y = (int)event.getY(tcId);
				//Log.i("TOUCH","pointer Count = "+pointerCount+",PID="+tcId);
				if(x_ratio != 1)
					x = (int)(x*x_ratio);			
				if(y_ratio != 1)
					y = (int)(y*y_ratio); 
				
				switch(actionCode) {
				case MotionEvent.ACTION_DOWN:
				case MotionEvent.ACTION_POINTER_DOWN:
					//Log.i("TOUCH","P["+i+","+tcId+"]x ="+x+",y ="+y);
					appTh.BhandleTouchPress(x , y,tcId);
					return true;
				case MotionEvent.ACTION_UP:
				case MotionEvent.ACTION_POINTER_UP:
					//Log.i("TOUCH","R["+i+","+tcId+"]x ="+x+",y ="+y);
					appTh.BhandleTouchRelease(x , y,tcId);
					return true;
				case MotionEvent.ACTION_MOVE:
					//Log.i("TOUCH","M["+i+","+tcId+"]x ="+x+",y ="+y);
					appTh.BhandleTouchDrag(x , y,tcId);
					return true;
				}
			}
			return super.onTouchEvent(event);
		}
		
		private int getWipiTouchEvent(int action) {
			int ret = -1;
			
			switch(action) {
			case MotionEvent.ACTION_DOWN :
				ret = MH_POINT_PRESSEVENT;
				break;
			case MotionEvent.ACTION_UP  :
				ret = MH_POINT_RELEASEEVENT;
				break;
			case MotionEvent.ACTION_MOVE :
				ret = MH_POINT_DRAGEVENT;
				break;
			}
			
			return ret;	
		}
	}
