	//!@wjl 네트웍 wifi,mobile 상태 체크	//2011/06/15
	public int getNetworkInfo()
	{
		int netinfo = 0;
		ConnectivityManager mng = (ConnectivityManager)this.context.getSystemService(Context.CONNECTIVITY_SERVICE);
		NetworkInfo ni = mng.getNetworkInfo(ConnectivityManager.TYPE_WIFI);
		boolean isWifi = false;
		boolean isMobile = false;
		if(ni!=null)
		{
			 isWifi = ni.isConnectedOrConnecting();
		}
		if(isWifi)
		{
			netinfo = 1;
		}else{
			ni = mng.getNetworkInfo(ConnectivityManager.TYPE_MOBILE);
			if(ni!=null)
			{
				isMobile = ni.isConnectedOrConnecting();
				if(isMobile)
				{
					netinfo = 2;
				}
			}
		}
		return(netinfo);
	}
	
		
	
	public void setContext(Context appContext) {
		this.context = appContext;
	}
	
	public byte[] getResZip(){
		String extResPath = AppProperty.getString("ext_res");

		if (extResPath == null)
			return getAssetResZip();
		return getExtResZip(extResPath);
	}
	
//	public byte[] getResZip(){
	public byte[] getAssetResZip(){
		try { 
			InputStream is = context.getAssets().open("res.dat"); 
	
			// We guarantee that the available method returns the total 
			// size of the asset... of course, this does mean that a single 
			// asset can't be more than 2 gigs. 
			int size = is.available(); 
	
			// Read the entire asset into a local byte buffer. 
			byte[] buffer = new byte[size]; 
			is.read(buffer); 
			is.close();
			return buffer;
		} catch (IOException e) { 
			// Should never happen! 
			throw new RuntimeException(e); 
		} 
	}
	
	
	public byte[] getExtResZip(String resPath){
		try { 
			File myfile = new File(resPath+"res.dat");
			java.io.FileInputStream inbuf = new java.io.FileInputStream(myfile);
			FileDescriptor fd = inbuf.getFD();

			int size = inbuf.available(); 
	
			// Read the entire asset into a local byte buffer. 
			byte[] buffer = new byte[size]; 
			inbuf.read(buffer); 
			inbuf.close();
			return buffer;
		} catch (IOException e) { 
			// Should never happen! 
			throw new RuntimeException(e); 
		} 
		
	}

