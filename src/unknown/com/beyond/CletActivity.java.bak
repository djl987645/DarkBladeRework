	}
	
	
	public void startCheck(String appID) {
		try {
           Class justclass = Class.forName("com.skt.ScreenConfig");
           ((ScreenConfig)(justclass.newInstance())).runCheck(appID);
		} catch (Exception e) {
			// TODO Auto-generated catch block
			e.printStackTrace();
		} 
	}	
		

	public void appStart() {
		if (soundPoolRes != null)
			appTh = new AppThread(this, soundPoolRes); 
		else 
			appTh = new AppThread(this);
		subCreate();			
	}
	
	public void finish() {
		super.finish();
		if(appTh != null)
			appTh.pltFinish();
	}
	
	public void destroyProcess() {
		//jasper System.exit(0);
		android.os.Process.killProcess(android.os.Process.myPid()); 
	}
	
