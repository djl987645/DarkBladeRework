	//////////////////////////////////////////////////////////////////////
	
	public static boolean isConnected = false;  
	//wipic network 
	
	ArrayList<MySocket> socketMg = new ArrayList<MySocket>();  
	
	public int netSocket(int  domain,int  type)
	{
		
		MySocket soc = new MySocket();
		soc.setOption(domain,type);// type == 1 tcp,2 udp
		
//		Log.i("TEST","JAVA_MC_netSocket start:"+soc.hashCode());
		{
			socketMg.add(soc);
			return soc.hashCode();
		}
		
	}
	
	public MySocket findSocket(int fd)
	{
		MySocket msoc = null;
		if(fd>=0)
		{
			int l = socketMg.size();
			for(int i = 0;i<l;i++)
			{
				msoc = socketMg.get(i);
				if(msoc!=null){
					if(msoc.hashCode() == fd)
					{
						return msoc;
					}
				}
			}
		}
		return null;
	}
	
	
	public int netSocketConnect ( int  fd,String  addr,int  port,int  param)
	{
		MySocket msoc = findSocket(fd);
			
		if(msoc!=null)
		{
			msoc.CBconnect = param;
			msoc.connect(addr, port);
			return 0;// 접속 시도 성공.
		}
		return -1;
	}
	
	public int netSetWriteCB(int fd,int param)
	{
		
		MySocket msoc = findSocket(fd);
//		Log.i("TEST","netSetWriteCB("+fd+","+param+") msoc = "+msoc);
		if(msoc!=null)
		{
			msoc.CBwrite = param;
			
			return 0;// readCB 등록.
		}
				
		return -1;
	}
	
	public int netSocketWrite(int fd,byte[] w,int len,int param)
	{
		MySocket msoc = findSocket(fd);
		if(msoc!=null)
			return(msoc.write(w, 0, len));
		return -1;
	}
	public int netSetReadCB(int fd,int param)
	{
		MySocket msoc = findSocket(fd);
//		Log.i("TEST","netSetReadCB("+fd+","+param+") msoc = "+msoc);
		if(msoc!=null)
		{
			msoc.CBread = param;
			return 0;// readCB 등록.
		}

		return -1;
	}
	
	public void OpenURL(String url){
		Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(url)); 
		JletActivity.context.startActivity(intent);
	}

	public int netSocketRead(int fd,byte[] r,int len,int param)
	{
		MySocket msoc = findSocket(fd);
		//Log.i("TEST","netSocketRead"); 
		if(msoc!=null && param!=0)
		{
			if(msoc.cs!=null && msoc.cs.isConnected() == false)
			{
				return -1;
			}
			//Log.i("TEST","netSocketRead 1len = "+len+","+msoc.readBuffer.remaining());
			
			if(msoc.outByte!=null)//임시 버퍼모드
			{
				//Log.i("TEST","netSocketRead outByte.size = "+len+","+msoc.outByte.size());
				if(msoc.outByte.size() > 0)
				{
					if(msoc.inByte==null){
						
						msoc.inByte = new ByteArrayInputStream(msoc.outByte.toByteArray());
						msoc.outByte.reset();
						//Log.i("TEST","netSocketRead inBYte = "+msoc.inByte.available()+",outByte:"+msoc.outByte.size());
					}
				}
				if(msoc.inByte==null)
				{
					if(len==0)
					{
						return 0;
					}
					else{
						return -19;
					}
				}
				else{
					int l = msoc.inByte.available();
					
					if(l<len)
					{
						len = l;
					}
					//Log.i("TEST","netSocketRead inBYte = "+len);
					len = msoc.inByte.read(r,0,len);
					if(msoc.inByte.available()<=0)
					{
						msoc.inByte = null;
						readCount++;
						Log.i("TEST","netSocketRead READ OK END:"+readCount);
						
					}
				}
				
				//Log.i("TEST","netSocketRead 1len = "+len);
				return len;
			}else{
				return -19;//woudblock
			}
		}
		return -1;
	}

	
	public int netSocketClose(int fd)
	{
		MySocket msoc = findSocket(fd);
		Log.i("TEST","netSocketClose fd="+fd+msoc);
		try {
			if(msoc!=null)
			{
				Log.i("TEST","netSocketClose OK");
				msoc.close();
				return 0;
			}
		} catch (Exception e) {
			// TODO Auto-generated catch block
			Log.i("ERROR","netSocketClose ERROR:");
			e.printStackTrace();
			return -1;
		}
		return -1;
	}
	
	public int netClose()
	{
		int l=socketMg.size();
		MySocket msoc = null;
		for(int i = 0;i<l;i++)
		{
			try {
				msoc = socketMg.get(i);
				Log.i("TEST","netClose :"+i+msoc);
				if(msoc!=null)
				{
					msoc.close();
					msoc = null;
				}
			} catch (Exception e) {
				// TODO Auto-generated catch block
				e.printStackTrace();
			}
		}
		socketMg.clear();
		return 0;
	}
	//외부에서  접속 콜백으로 접속 시도
	public void MyScoket_connection(Object obj)
	{
		if(obj!=null)
		{
			MySocket msc = (MySocket)obj;
			msc.connection();
		}
	}
	
			
